# Frontend specific .gitignore

# Environment variables
.env
.env.local
.env.production
.env.production.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/

# Temporary files
*.tmp
.cache/
