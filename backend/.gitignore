# Backend specific .gitignore

# Environment variables
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
build/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Uploads
uploads/*
!uploads/.gitkeep
!uploads/products/.gitkeep

# PM2
.pm2/
ecosystem.config.js

# Testing
coverage/

# Temporary files
*.tmp
.cache/
